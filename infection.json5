{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // The Psalm hook classes themselves are plumbing their mutants cannot
    // reach from a unit test — the decisions they delegate to are what this
    // number is about. Set at introduction (2026-08-24) and to be raised once
    // the plugin has more than one rule.
    "minMsi": 85,
    "mutators": {
        "@default": true
    }
}

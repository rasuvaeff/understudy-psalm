{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // The Psalm hook classes themselves are plumbing their mutants cannot
    // reach from a unit test — the decisions they delegate to are what this
    // number is about. 85 at introduction (2026-08-24), when the plugin had
    // one rule and no unit test for it.
    //
    // Re-measured 2026-09-04 on PHP 8.4 — the version the `Coverage &
    // Mutation` job pins, and mutants can differ between versions: 197 of 201
    // killed, 98.01%.
    //
    // The denominator nearly tripled that day, and not because code was
    // added: `Cardinality` and `ClosureShape` gained unit tests, and Infection
    // maps mutants through `#[Covers]` rather than through what a test
    // actually executes — a class no test covers contributes no mutants at
    // all. A jump in the total is what adding a unit test looks like here.
    //
    // The four survivors are equivalent and cannot be killed: `ScopeIndex`'s
    // `$startLine <= $endLine` mutated to `<`, where both branches build the
    // same pair when the bounds are equal; `Cardinality`'s `return null` in
    // the `never` branch, where falling through computes the same null; and
    // both integer mutants on `ClosureShape`'s `new self(1, 0)` fallback,
    // whose `staticCalls` is read only when `methodCalls` is zero. The last
    // three are the same three the PHPStan sibling has recorded since its own
    // internals were covered.
    //
    // The gate is one mutant below the measurement — `floor(100 * (killed - 1)
    // / tested)` — so that one hard-to-kill line from an unrelated change does
    // not redden the build before anybody has looked at it.
    "minMsi": 97,
    "mutators": {
        "@default": true
    }
}
